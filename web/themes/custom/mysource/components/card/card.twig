{%
  set card_classes = [
    'card',
    'flex',
    'flex-col',
    'gap-4',
    'bg-slate-100',
    'rounded-xl',
    'p-4',
    'font-tilt-neon'
  ]
%}

<article {{ attributes.addClass(card_classes) }}>
  <div class="card_image [&_img]:w-full">
    {{ card_image }}
  </div>

  {% block headerSlot %}
    <h2 class="card_title">
      {{ card_title }}
    </h2>
  {% endblock headerSlot %}

  <div class="card_description">
    {{ card_description }}
  </div>
  <div class="card_ctas">
    {{ card_ctas }}
  </div>
</article>
